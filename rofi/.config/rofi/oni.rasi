/*******************************************************************************
 * ONI THEME - REFEITO PARA TRANSPARÊNCIA (FEDORA SWAY)
 *******************************************************************************/

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    drun-display-format:        "{name}";
}

* {
    /* Cores extraídas do seu style.css */
    bg-color:            rgba(25, 35, 65, 0.85);  /* Azul Marinho Translúcido */
    bg-selected:         rgba(138, 100, 200, 0.4); /* Roxo da borda Waybar */
    fg-color:            #e8d5ff;                 /* Lavanda */
    accent-color:        #ff6b9d;                 /* Rosa Neon (Urgent/Oni Eyes) */
    border-color-oni:    rgba(138, 100, 200, 0.8); /* Roxo sólido da borda */

    font: "Noto Sans Mono 12";
}

window {
    /* Ativa a transparência real no Wayland */
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    width:               600px;
    x-offset:            0px;
    y-offset:            0px;

    enabled:             true;
    margin:              0px;
    padding:             0px;
    border:              3px solid;
    border-radius:       15px;
    border-color:        @border-col-oni;
    background-color:    @bg-color;
    cursor:              "default";
}

mainbox {
    enabled:             true;
    spacing:             10px;
    margin:              0px;
    padding:             30px;
    border:              0px solid;
    border-radius:       0px;
    background-color:    transparent;
    children:            [ "inputbar", "listview" ];
}

inputbar {
    enabled:             true;
    spacing:             10px;
    margin:              0px;
    padding:             10px;
    border:              0px 0px 2px 0px;
    border-radius:       0px;
    border-color:        @border-col-oni;
    background-color:    transparent;
    text-color:          @fg-color;
    children:            [ "prompt", "entry" ];
}

prompt {
    enabled:             true;
    background-color:    transparent;
    text-color:          @accent-color;
}

entry {
    enabled:             true;
    background-color:    transparent;
    text-color:          @fg-color;
    cursor:              text;
    placeholder:         "Buscar...";
    placeholder-color:   inherit;
}

listview {
    enabled:             true;
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    reverse:             false;
    fixed-height:        true;
    fixed-columns:       true;

    spacing:             5px;
    margin:              0px;
    padding:             0px;
    border:              0px;
    background-color:    transparent;
    text-color:          @fg-color;
    cursor:              "default";
}

element {
    enabled:             true;
    spacing:             10px;
    margin:              0px;
    padding:             8px;
    border:              0px;
    border-radius:       8px;
    background-color:    transparent;
    text-color:          @fg-color;
    cursor:              pointer;
}

element selected.normal {
    background-color:    @bg-selected;
    text-color:          @accent-color;
    border:              0px 0px 0px 4px;
    border-color:        @accent-color;
}

element-icon {
    background-color:    transparent;
    text-color:          inherit;
    size:                24px;
    cursor:              inherit;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           inherit;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}
